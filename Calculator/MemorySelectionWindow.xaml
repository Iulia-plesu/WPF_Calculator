<Window x:Class="Calculator.MemorySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selectați o valoare din stivă" Height="300" Width="300">
    <Grid>
        <ListBox x:Name="MemoryListBox" Margin="10" SelectionMode="Single" />
        <Button Content="Selectați" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,254,0,0" Click="SelectButton_Click" />
    </Grid>
</Window>