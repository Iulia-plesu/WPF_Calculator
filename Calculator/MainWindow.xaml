<Window x:Class="Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator"
        mc:Ignorable="d"
        Title="Calculator" Height="530" Width="318"
        KeyDown="Window_KeyDown">
    <Window.DataContext>
        <local:Standard/>
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#2D2D30">
        <Border x:Name="SideMenu" Width="150" Background="#1E1E1E" HorizontalAlignment="Left" Margin="-150,0,0,0" Panel.ZIndex="1"
                MouseEnter="SideMenu_MouseEnter" MouseLeave="SideMenu_MouseLeave">
            <StackPanel>
                <Button Content="Standard" Style="{StaticResource MenuButtonStyle}" Command="{Binding SwitchToStandardCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Content="Programmer" Style="{StaticResource MenuButtonStyle}" Command="{Binding SwitchToProgrammerCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

                <Menu Style="{StaticResource MenuStyle}">
                    <MenuItem Header="File" Style="{StaticResource MenuItemStyle}">
                        <MenuItem Header="Cut" Command="{Binding CutCommand}" Style="{StaticResource MenuItemStyle}"/>
                        <MenuItem Header="Copy" Command="{Binding CopyCommand}" Style="{StaticResource MenuItemStyle}"/>
                        <MenuItem Header="Paste" Command="{Binding PasteCommand}" Style="{StaticResource MenuItemStyle}"/>
                    </MenuItem>
                </Menu>

                <Menu Style="{StaticResource MenuStyle}">
                    <MenuItem Header="Help" Style="{StaticResource MenuItemStyle}">
                        <MenuItem Header="About" Command="{Binding AboutCommand}" Style="{StaticResource MenuItemStyle}"/>
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Border>

        <DockPanel LastChildFill="True" VerticalAlignment="Top" Height="40">
            <Button Content="☰" FontSize="16" Foreground="Black" Margin="10,0,0,0" VerticalAlignment="Center" Command="{Binding ToggleMenuCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <TextBlock Text="Standard" FontSize="14" Foreground="White" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <DockPanel DockPanel.Dock="Right" Margin="0,0,10,0">
                <TextBlock Text="&#xE74E;" FontSize="16" Foreground="White" FontFamily="Segoe MDL2 Assets" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="&#xE81C;" FontSize="16" Foreground="White" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </DockPanel>

        <StackPanel Orientation="Vertical" Margin="10,40,10,0" VerticalAlignment="Top">
            <TextBox Name="OperationDisplay" 
                 FontSize="14" 
                 Foreground="White" 
                 Background="#2D2D30" 
                 BorderThickness="0" 
                 TextAlignment="Right" 
                 IsReadOnly="True" 
                 Margin="10,5,10,5" 
                 Text="{Binding OperationString, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ItemsControl ItemsSource="{Binding CurrentValueDisplay}" Grid.Row="1" Margin="0, 0, 10, 0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" 
                           FontSize="24" 
                           Foreground="White"
                           Margin="1,0,1,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Background="#333" CornerRadius="10" Margin="10,120,10,10" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="MC" Grid.Row="0" Grid.Column="0" Background="#2D2D30" Foreground="White" FontSize="10" Padding="10" BorderBrush="Transparent" BorderThickness="0" Margin="0" Command="{Binding MemoryClearCommand}"/>
                <Button Content="MR" Grid.Row="0" Grid.Column="1" Background="#2D2D30" Foreground="White" FontSize="10" Padding="10" BorderBrush="Transparent" BorderThickness="0" Margin="0" Command="{Binding MemoryRecallCommand}"/>
                <Button Content="M+" Grid.Row="0" Grid.Column="2" Background="#2D2D30" Foreground="White" FontSize="10" Padding="10" BorderBrush="Transparent" BorderThickness="0" Margin="0" Command="{Binding MemoryAddCommand}"/>
                <Button Content="M-" Grid.Row="0" Grid.Column="3" Background="#2D2D30" Foreground="White" FontSize="10" Padding="10" BorderBrush="Transparent" BorderThickness="0" Margin="0" Command="{Binding MemorySubtractCommand}"/>
                <Button Content="MS" Grid.Row="0" Grid.Column="4" Background="#2D2D30" Foreground="White" FontSize="10" Padding="10" BorderBrush="Transparent" BorderThickness="0" Margin="0" Command="{Binding MemoryStoreCommand}"/>
                <Button Content="Mv" Grid.Row="0" Grid.Column="5" Background="#2D2D30" Foreground="White" FontSize="10" Padding="10" BorderBrush="Transparent" BorderThickness="0" Margin="0" Command="{Binding MemoryStackCommand}"/>
            </Grid>
        </Border>

        <Border Background="#333" CornerRadius="10" Margin="10,160,10,10" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="%" Grid.Row="0" Grid.Column="0" Background="#666" Foreground="White" FontSize="15" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding PercentageCommand}"/>
                <Button Content="CE" Grid.Row="0" Grid.Column="1" Background="#666" Foreground="White" FontSize="15" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding ClearEntryCommand}"/>
                <Button Content="C" Grid.Row="0" Grid.Column="2" Background="#666" Foreground="White" FontSize="15" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding ClearCommand}"/>
                <Button Content="⌫" Grid.Row="0" Grid.Column="3" Background="#666" Foreground="White" FontSize="15" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding BackspaceCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0">
                                <Border.CornerRadius>
                                    <CornerRadius TopLeft="0" TopRight="10" BottomLeft="0" BottomRight="0"/>
                                </Border.CornerRadius>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="⅟x" Grid.Row="1" Grid.Column="0" Background="#666" Foreground="White" FontSize="15" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding ReciprocalCommand}"/>
                <Button Content="x²" Grid.Row="1" Grid.Column="1" Background="#666" Foreground="White" FontSize="15" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding SquareCommand}"/>
                <Button Content="²√x" Grid.Row="1" Grid.Column="2" Background="#666" Foreground="White" FontSize="15" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding SquareRootCommand}"/>
                <Button Content="÷" Grid.Row="1" Grid.Column="3" Background="#666" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding SetOperationCommand}" CommandParameter="÷"/>

                <Button Content="7" Grid.Row="2" Grid.Column="0" Background="#444" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding AppendNumberCommand}" CommandParameter="7"/>
                <Button Content="8" Grid.Row="2" Grid.Column="1" Background="#444" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding AppendNumberCommand}" CommandParameter="8"/>
                <Button Content="9" Grid.Row="2" Grid.Column="2" Background="#444" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding AppendNumberCommand}" CommandParameter="9"/>
                <Button Content="×" Grid.Row="2" Grid.Column="3" Background="#666" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding SetOperationCommand}" CommandParameter="×"/>

                <Button Content="4" Grid.Row="3" Grid.Column="0" Background="#444" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding AppendNumberCommand}" CommandParameter="4"/>
                <Button Content="5" Grid.Row="3" Grid.Column="1" Background="#444" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding AppendNumberCommand}" CommandParameter="5"/>
                <Button Content="6" Grid.Row="3" Grid.Column="2" Background="#444" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding AppendNumberCommand}" CommandParameter="6"/>
                <Button Content="-" Grid.Row="3" Grid.Column="3" Background="#666" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding SetOperationCommand}" CommandParameter="-"/>

                <Button Content="1" Grid.Row="4" Grid.Column="0" Background="#444" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding AppendNumberCommand}" CommandParameter="1"/>
                <Button Content="2" Grid.Row="4" Grid.Column="1" Background="#444" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding AppendNumberCommand}" CommandParameter="2"/>
                <Button Content="3" Grid.Row="4" Grid.Column="2" Background="#444" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding AppendNumberCommand}" CommandParameter="3"/>
                <Button Content="+" Grid.Row="4" Grid.Column="3" Background="#666" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding SetOperationCommand}" CommandParameter="+"/>

                <Button Content="±" Grid.Row="5" Grid.Column="0" Background="#444" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding ChangeSignCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0">
                                <Border.CornerRadius>
                                    <CornerRadius TopLeft="0" TopRight="0" BottomLeft="10" BottomRight="0"/>
                                </Border.CornerRadius>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="0" Grid.Row="5" Grid.Column="1" Background="#444" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding AppendNumberCommand}" CommandParameter="0"/>
                <Button Content="." Grid.Row="5" Grid.Column="2" Background="#444" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding AddDecimalPointCommand}"/>
                <Button Content="=" Grid.Row="5" Grid.Column="3" Background="#A084E8" Foreground="White" FontSize="18" BorderBrush="Transparent" BorderThickness="0" Padding="10" Command="{Binding CalculateCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0">
                                <Border.CornerRadius>
                                    <CornerRadius TopLeft="0" TopRight="0" BottomLeft="0" BottomRight="10"/>
                                </Border.CornerRadius>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>