<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="Calculator" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="DigitGroupingEnabled" Type="System.Boolean" Scope="User">
      <Value Profile="(Default)">True</Value>
    </Setting>
    <Setting Name="CalculatorMode" Type="System.String" Scope="User">
      <Value Profile="(Default)">Programmer</Value>
    </Setting>
    <Setting Name="SelectedBase" Type="System.String" Scope="User">
      <Value Profile="(Default)">DEC</Value>
    </Setting>
  </Settings>
</SettingsFile>